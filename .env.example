# Copy to .env and fill in. .env is gitignored; this file is tracked.

# Base mainnet -- used by [profile.fork] via the `base` rpc alias.
# A public endpoint (https://mainnet.base.org) works but is rate-limited;
# prefer a keyed provider for the group 4 fork suite.
BASE_RPC_URL=

# Base Sepolia (84532) -- deployment and the demo.
BASE_SEPOLIA_RPC_URL=

# Deployment key. Deploys AllowlistedERC4626 + MandateRouter (group 5).
DEPLOYER_PRIVATE_KEY=

# The human principal: owns the agentId in the ERC-8004 registry, signs the
# EIP-712 mandate, grants both allowances, and calls revoke in demo tx 9.
PRINCIPAL_PRIVATE_KEY=

# The agent's operating EOA: the only address the mandate permits to call
# depositFor/redeemFor. Never funded with USDC (the containment invariant).
AGENT_PRIVATE_KEY=

# Contract verification. Consumed via the [etherscan] table in foundry.toml,
# not read directly by forge from the environment.
BASESCAN_API_KEY=

# --- Group 5 config. Per DESIGN decision 7 the registry is a constructor
# parameter, not a constant, so Base Sepolia and a local fork differ by config
# rather than by code.

# Which testnet group 5 deploys to. Omit both and it is Base Sepolia, which is
# what the WISH's acceptance criteria name.
#
#   Base Sepolia      TARGET_CHAIN_ID=84532
#                     USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
#   Ethereum Sepolia  TARGET_CHAIN_ID=11155111
#                     USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
#
# An address is derived from its private key alone, so it is identical on every
# EVM chain while balances and nonces are per-chain. Funding the right address on
# the wrong chain therefore fails silently -- nothing errors, the balance is just
# zero where it matters. TARGET_CHAIN_ID is asserted against the RPC's own
# eth_chainId before anything is signed.
TARGET_RPC_URL=
TARGET_CHAIN_ID=

# ERC-8004 AgentIdentity. Same address on both Sepolias (deterministic deploy). Live and permissionless; register()
# mints to msg.sender, which is why Deploy.s.sol broadcasts that one call under
# PRINCIPAL_PRIVATE_KEY. See additional_docs/.../group-5-constraints.md.
REGISTRY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e

# Circle test USDC on Base Sepolia, 6 decimals.
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Written by `forge script script/Deploy.s.sol --broadcast`, then read by
# `pnpm demo`. Leave unset to have the demo resolve them from
# broadcast/Deploy.s.sol/<chainId>/run-latest.json instead of by hand.
VAULT_ADDRESS=
ROUTER_ADDRESS=
AGENT_ID=
